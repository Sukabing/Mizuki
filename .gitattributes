# 核心规则：所有文本文件自动检测，仓库内统一为LF
* text=auto eol=lf

# 明确指定文本文件类型（防止Git误判）
*.md text
*.ts text
*.js text
*.tsx text
*.jsx text
*.vue text
*.css text
*.scss text
*.html text
*.json text
*.yml text
*.yaml text
*.toml text
*.sh text
*.bash text
*.gitignore text
*.gitattributes text

# 明确指定Windows批处理文件使用CRLF（特殊情况）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 构建产物目录：禁用换行符转换（覆盖上方所有文本规则）
dist/** -text

# 所有二进制文件不做任何转换（防止损坏）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
